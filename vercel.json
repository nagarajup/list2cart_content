{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app",
      "destination": "https://play.google.com/store/apps/details?id=com.aniapps.grocerychecklist",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "https://play.google.com/store/apps/details?id=com.aniapps.grocerychecklist",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/l/:code", "destination": "/l/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
